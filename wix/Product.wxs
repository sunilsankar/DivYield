<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
    <Product Id="*" 
             Name="DivYield" 
             Language="1033" 
             Version="0.1.0" 
             Manufacturer="DivYield" 
             UpgradeCode="82e70c5e-859a-4c91-9e79-8d4a6136be0a">
             
        <Package InstallerVersion="301" 
                 Compressed="yes" 
                 InstallScope="perMachine" 
                 Description="DivYield - Fast, Smooth Portfolio and Dividend Tracker" />

        <MajorUpgrade DowngradeErrorMessage="A newer version of DivYield is already installed." />
        <MediaTemplate EmbedCab="yes" />

        <!-- Directory Structure -->
        <Directory Id="TARGETDIR" Name="SourceDir">
            <!-- Program Files Folder -->
            <Directory Id="ProgramFilesFolder">
                <Directory Id="INSTALLFOLDER" Name="DivYield" />
            </Directory>
            <!-- Start Menu Programs Folder -->
            <Directory Id="ProgramMenuFolder">
                <Directory Id="ApplicationProgramsFolder" Name="DivYield" />
            </Directory>
            <!-- Desktop Folder -->
            <Directory Id="DesktopFolder" Name="Desktop" />
        </Directory>

        <!-- Brand Icon -->
        <Icon Id="AppIcon" SourceFile="assets/icon.ico" />
        <Property Id="ARPPRODUCTICON" Value="AppIcon" />
        <Property Id="ARPHELPLINK" Value="https://github.com/sunilsankar/DivYield" />
        <Property Id="ARPURLINFOABOUT" Value="https://github.com/sunilsankar/DivYield" />
        <Property Id="ARPNOREPAIR" Value="yes" />

        <!-- Permanent Icon File in Installation Folder -->
        <DirectoryRef Id="INSTALLFOLDER">
            <Component Id="AppIconComponent" Guid="e83a48e2-9b51-4e78-8319-3c97193b2184">
                <File Id="AppIconFile" Source="assets/icon.ico" Name="icon.ico" KeyPath="yes" />
            </Component>
        </DirectoryRef>

        <!-- Start Menu Shortcuts (App Launcher + Uninstaller) -->
        <DirectoryRef Id="ApplicationProgramsFolder">
            <Component Id="ApplicationShortcut" Guid="f319207e-0be5-4cf5-b16f-87030232490b">
                <!-- Application Launcher -->
                <Shortcut Id="ApplicationStartMenuShortcut"
                          Name="DivYield"
                          Description="DivYield - Fast, smooth portfolio and dividend tracker"
                          Target="[INSTALLFOLDER]DivYield.exe"
                          WorkingDirectory="INSTALLFOLDER"
                          Advertise="no"
                          Icon="AppIcon" />

                <!-- Uninstaller Shortcut -->
                <Shortcut Id="UninstallProductShortcut"
                          Name="Uninstall DivYield"
                          Description="Uninstalls DivYield from your computer"
                          Target="[SystemFolder]msiexec.exe"
                          Arguments="/x [ProductCode]"
                          Advertise="no"
                          Icon="AppIcon" />

                <RemoveFolder Id="CleanUpShortCut" On="uninstall" />
                <RegistryValue Root="HKLM" 
                               Key="Software\DivYield" 
                               Name="installed" 
                               Type="integer" 
                               Value="1" 
                               KeyPath="yes" />
            </Component>
        </DirectoryRef>

        <!-- Desktop Shortcut -->
        <DirectoryRef Id="DesktopFolder">
            <Component Id="ApplicationDesktopShortcut" Guid="7d192134-9271-4d1e-8e42-7c34b1239912">
                <Condition>INSTALLDESKTOPSHORTCUT = 1</Condition>
                <Shortcut Id="DesktopShortcut"
                          Name="DivYield"
                          Description="DivYield - Fast, smooth portfolio and dividend tracker"
                          Target="[INSTALLFOLDER]DivYield.exe"
                          WorkingDirectory="INSTALLFOLDER"
                          Advertise="no"
                          Icon="AppIcon" />
                <RegistryValue Root="HKLM" 
                               Key="Software\DivYield" 
                               Name="desktop_shortcut" 
                               Type="integer" 
                               Value="1" 
                               KeyPath="yes" />
            </Component>
        </DirectoryRef>

        <!-- Features -->
        <Feature Id="ProductFeature" Title="DivYield" Level="1">
            <ComponentGroupRef Id="DivYieldComponents" />
            <ComponentRef Id="AppIconComponent" />
            <ComponentRef Id="ApplicationShortcut" />
            <ComponentRef Id="ApplicationDesktopShortcut" />
        </Feature>

        <!-- UI Configuration with Shortcut Selection & Launch Application -->
        <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
        <Property Id="INSTALLDESKTOPSHORTCUT" Value="1" />
        <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch DivYield" />
        <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
        <WixVariable Id="WixUILicenseRtf" Value="wix/license.rtf" />

        <CustomAction Id="LaunchApplication" 
                      Directory="INSTALLFOLDER" 
                      ExeCommand="&quot;[INSTALLFOLDER]DivYield.exe&quot;" 
                      Execute="immediate" 
                      Impersonate="yes" 
                      Return="asyncNoWait" />

        <UI>
            <UIRef Id="WixUI_InstallDir" />

            <Dialog Id="ShortcutDlg" Width="370" Height="270" Title="[ProductName] Setup">
                <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
                <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
                <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
                <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Additional Shortcuts" />
                <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes" Text="Select whether to create a desktop shortcut." />

                <Control Id="DesktopShortcutCheckbox" Type="CheckBox" X="25" Y="80" Width="320" Height="18" Property="INSTALLDESKTOPSHORTCUT" CheckBoxValue="1" Text="Create a &amp;desktop shortcut" />
                <Control Id="DetailsText" Type="Text" X="45" Y="105" Width="290" Height="30" Text="Place a shortcut for DivYield on your Desktop for quick access." />

                <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="&amp;Back">
                    <Publish Event="NewDialog" Value="InstallDirDlg">1</Publish>
                </Control>
                <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="&amp;Next">
                    <Publish Event="NewDialog" Value="VerifyReadyDlg">1</Publish>
                </Control>
                <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
                    <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
                </Control>
            </Dialog>

            <!-- Route InstallDirDlg Next to ShortcutDlg -->
            <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="ShortcutDlg" Order="4">WIXUI_DONTVALIDATEPATH OR WIXUI_INSTALLDIR_VALID=&quot;1&quot;</Publish>

            <!-- Route VerifyReadyDlg Back to ShortcutDlg -->
            <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="ShortcutDlg" Order="1">NOT Installed</Publish>

            <!-- Launch DivYield on Finish if checkbox is checked -->
            <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApplication">WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed</Publish>
        </UI>
    </Product>
</Wix>
